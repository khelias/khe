# The KHE repos are independent checkouts cloned by scripts/workspace.sh.
# `repos/*` rather than `repos/` so the manifest and README stay tracked.
/repos/*
!/repos/README.md
!/repos/repos.yaml

# Local-only overrides (per-machine, not committed)
*.local.md
*.local.toml
*.local.json
.claude/launch.json

# Tool output
.playwright-mcp/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
